{
  "name": "pw_e2e_typescript_web_api_framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "codegen": "npx playwright codegen",
    "test": "npx playwright test",
    "test:qa": "ENV=qa npx playwright test",
    "test:stage": "ENV=stage npx playwright test",
    "test:dev": "ENV=dev npx playwright test",
    "test:prod": "ENV=prod npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:chrome": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "allure:clean": "rm -rf allure-results allure-report"
  },
  "keywords": [],
  "author": "Sudhanshu Gautam",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.5.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.12.2",
    "reporting-labs": "^0.6.2"
  },
  "dependencies": {
    "@playwright/test": "^1.61.1",
    "ajv": "^8.20.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "playwright": "^1.61.1",
    "reporting": "^1.0.0",
    "xlsx": "^0.18.5"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  }
}
